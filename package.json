{
  "name": "@abiswas97/steam-mcp",
  "version": "0.1.2",
  "description": "A remote-first, read-only Steam MCP server with local stdio support.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonboncinnabon/steam-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bonboncinnabon/steam-mcp/issues"
  },
  "homepage": "https://github.com/bonboncinnabon/steam-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "steam"
  ],
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/hosted-setup.md",
    "docs/local-setup.md",
    "docs/operations.md",
    "docs/testing.md",
    "docs/tool-reference.md",
    "docs/upstream-sources.md",
    "docs/adr/0002-static-bearer-authentication.md"
  ],
  "bin": {
    "steam-mcp": "dist/bin/steam-mcp.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "mutation": "stryker run",
    "package:release": "node scripts/package-release.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:coverage": "vitest run --coverage",
    "test:inspector": "pnpm build && vitest run --config vitest.conformance.config.ts",
    "test:integration": "vitest run test/integration",
    "test:high-risk": "vitest run --config vitest.high-risk.config.ts --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/inspector-cli": "1.0.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
