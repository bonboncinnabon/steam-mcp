{
  "name": "steam-mcp-server",
  "version": "0.0.0",
  "description": "A remote-first, read-only Steam MCP server with local stdio support.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "steam-mcp": "dist/bin/steam-mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "mutation": "stryker run",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:coverage": "vitest run --coverage",
    "test:inspector": "pnpm build && vitest run --config vitest.conformance.config.ts",
    "test:high-risk": "vitest run --config vitest.high-risk.config.ts --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "jose": "^6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/inspector-cli": "1.0.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
